<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>fr._.lpz | TikTok Creator</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <style>
        :root {
            --primary-color: #fe2c55;
            --secondary-color: #25f4ee;
            --dark-color: #121212;
            --light-color: #f8f8f8;
            --instagram-color: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
            --facebook-color: #1877f2;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            background-color: var(--dark-color);
            color: white;
            position: relative;
            min-height: 100vh;
            padding-bottom: 80px; /* Space for fixed language bar */
        }
        
        header {
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            padding: 20px;
            text-align: center;
            position: relative;
        }
        
        .profile-container {
            margin-top: -50px;
            text-align: center;
            padding: 0 20px;
        }
        
        .profile-pic {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 4px solid white;
            background-color: #333;
            margin: 0 auto;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .profile-pic i {
            font-size: 60px;
        }
        
        h1 {
            margin-top: 15px;
            font-size: 2.2rem;
            color: white;
        }
        
        .username {
            font-size: 1.2rem;
            color: var(--secondary-color);
            margin-bottom: 20px;
        }
        
        .description {
            max-width: 600px;
            margin: 15px auto;
            line-height: 1.6;
            color: #ddd;
            font-size: 1.1rem;
            background-color: rgba(0, 0, 0, 0.2);
            padding: 15px;
            border-radius: 8px;
        }
        
        .section {
            max-width: 700px;
            margin: 40px auto;
            padding: 20px;
            background-color: #222;
            border-radius: 10px;
        }
        
        h2 {
            font-size: 1.8rem;
            margin-bottom: 20px;
            text-align: center;
            color: var(--primary-color);
        }
        
        .btn {
            display: inline-block;
            padding: 12px 25px;
            background-color: var(--primary-color);
            color: white;
            text-decoration: none;
            border-radius: 30px;
            font-weight: bold;
            margin: 10px;
            transition: all 0.3s ease;
        }
        
        .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(254, 44, 85, 0.5);
        }
        
        .btn-whatsapp {
            background-color: #25D366;
        }
        
        .btn-paypal {
            background-color: #0070BA;
        }
        
        .btn-instagram {
            background: var(--instagram-color);
        }
        
        .btn-facebook {
            background-color: var(--facebook-color);
        }
        
        .donation-options {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
        }
        
        .donation-amount {
            padding: 10px 20px;
            background-color: #333;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .donation-amount:hover {
            background-color: var(--primary-color);
        }
        
        footer {
            text-align: center;
            padding: 20px;
            margin-top: 30px;
            color: #777;
            font-size: 0.9rem;
        }
        
        .language-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background-color: rgba(0, 0, 0, 0.8);
            display: flex;
            justify-content: center;
            padding: 10px 0;
            z-index: 1000;
            backdrop-filter: blur(5px);
            border-top: 1px solid #333;
        }
        
        .language-btn {
            background-color: transparent;
            color: #ddd;
            border: none;
            padding: 8px 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 0 10px;
            font-size: 0.9rem;
            position: relative;
        }
        
        .language-btn:hover {
            color: var(--primary-color);
        }
        
        .language-btn.active {
            color: var(--secondary-color);
            font-weight: bold;
        }
        
        .language-btn.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 30px;
            height: 2px;
            background-color: var(--secondary-color);
        }
        
        /* Language specific content */
        .content-de, .content-en, .content-fr, .content-es {
            display: none;
        }
        
        /* Default language is German */
        .content-de {
            display: block;
        }
        
        /* Language active states controlled by JavaScript */
        html[lang="de"] .content-de { display: block; }
        html[lang="de"] .content-en, 
        html[lang="de"] .content-fr, 
        html[lang="de"] .content-es { display: none; }
        
        html[lang="en"] .content-en { display: block; }
        html[lang="en"] .content-de, 
        html[lang="en"] .content-fr, 
        html[lang="en"] .content-es { display: none; }
        
        html[lang="fr"] .content-fr { display: block; }
        html[lang="fr"] .content-de, 
        html[lang="fr"] .content-en, 
        html[lang="fr"] .content-es { display: none; }
        
        html[lang="es"] .content-es { display: block; }
        html[lang="es"] .content-de, 
        html[lang="es"] .content-en, 
        html[lang="es"] .content-fr { display: none; }
        
        @media (max-width: 768px) {
            .section {
                padding: 15px;
                margin: 20px 10px;
            }
            
            .description {
                padding: 10px;
                font-size: 1rem;
            }
            
            .language-btn {
                padding: 8px 10px;
                margin: 0 5px;
                font-size: 0.8rem;
            }
        }
    </style>
</head>
<body>
